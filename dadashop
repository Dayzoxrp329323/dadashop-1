      ).trim();

      if (
        !title ||
        !category ||
        !Number.isFinite(price) ||
        price <= 0
      ) {
        return res.status(400).json({
          error: "Informations de produit invalides."
        });
      }

      const firstPhoto =
        req.files && req.files.length
          ? "/uploads/" + req.files[0].filename
          : null;

      const result = db
        .prepare(
          `
          INSERT INTO products
          (
            seller_id,
            title,
            description,
            price,
            category,
            image,
            status,
            created_at
          )
          VALUES (?, ?, ?, ?, ?, ?, 'available', ?)
          `
        )
        .run(
          req.user.id,
          title,
          description,
          price,
          category,
          firstPhoto,
          new Date().toISOString()
        );

      res.json({
        success: true,
        productId: result.lastInsertRowid
      });
    } catch (error) {
      console.error(error);

      res.status(500).json({
        error: "Impossible de publier l'article."
      });
    }
  }
);

