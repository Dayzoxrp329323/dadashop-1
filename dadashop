app.post("/api/reviews", auth, (req, res) => {
  try {
    const productId = Number(req.body.productId);
    const rating = Number(req.body.rating);
    const comment = String(
      req.body.comment || ""
    ).trim();

    if (
      !Number.isInteger(rating) ||
      rating < 1 ||
      rating > 5
    ) {
      return res.status(400).json({
        error: "Note invalide."
      });
    }

    const product = db
      .prepare(
        "SELECT id FROM products WHERE id = ?"
      )
      .get(productId);

    if (!product) {
      return res.status(404).json({
        error: "Article introuvable."
      });
    }

    db.prepare(
      `
      INSERT INTO reviews
      (product_id, author_id, rating, comment, created_at)
      VALUES (?, ?, ?, ?, ?)
      `
    ).run(
      productId,
      req.user.id,
      rating,
      comment,
      new Date().toISOString()
    );

    res.json({
      success: true
    });
  } catch (error) {
    console.error(error);

    res.status(500).json({
