app.get("/api/products", (req, res) => {
  try {
    const search =
      String(req.query.search || "").trim().toLowerCase();

    const category =
      String(req.query.category || "").trim();

    let products = db
      .prepare(
        `
        SELECT
          p.id,
          p.title,
          p.description,
          p.price,
          p.category,
          p.image,
          p.status,
          p.created_at,
          u.name AS seller
        FROM products p
        JOIN users u ON u.id = p.seller_id
        WHERE p.status = 'available'
        ORDER BY p.id DESC
        `
      )
      .all();

    if (search) {
      products = products.filter((product) => {
        return (
          product.title
            .toLowerCase()
            .includes(search) ||
          String(product.description || "")
            .toLowerCase()
            .includes(search) ||
          product.category
            .toLowerCase()
            .includes(search)
        );
      });
    }

    if (category && category !== "all") {
      products = products.filter(
        (product) => product.category === category
      );
    }

    res.json({
      products
    });
  } catch (error) {
    console.error(error);

    res.status(500).json({
      error: "Impossible de charger les articles."
    });
  }
});

