          name="price"
          type="number"
          min="0.01"
          step="0.01"
          required
        >

      </div>

      <div class="field">

        <label>Catégorie</label>

        <select name="category" required>

          <option value="Mode">
            Mode
          </option>

          <option value="Chaussures">
            Chaussures
          </option>

