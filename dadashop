/* =========================================================
   API
========================================================= */

async function api(url, options={}){

  options.headers = {
    ...(options.headers || {})
  };

  if(token){
    options.headers.Authorization =
      "Bearer " + token;
  }

  const response =
    await fetch(url, options);

  const data =
    await response.json().catch(()=>({}));

  if(!response.ok){
    throw new Error(
      data.error || "Une erreur est survenue."
    );
  }

  return data;
}


/* =========================================================
   PRODUITS
========================================================= */

async function loadProducts(){

  try{

    const search =
      document.getElementById("search").value;

    const params =
      new URLSearchParams();

    if(search){
      params.set("search",search);
    }

    if(category !== "all"){
      params.set("category",category);
    }

    const data =
      await api(
        "/api/products?" +
        params.toString()
      );

    renderProducts(data.products);

  }catch(error){

    showToast(error.message);

  }

}


function renderProducts(products){

  const container =
    document.getElementById("products");

  document.getElementById("count")
    .textContent =
    products.length + " article(s)";

  if(!products.length){

    container.innerHTML = `
      <div class="empty">
        <div style="font-size:45px">🔎</div>
        <h3>Aucun article trouvé</h3>
        <p>Essaie une autre recherche.</p>
      </div>
    `;

    return;
  }

  container.innerHTML =
    products.map(product=>`

      <article class="card">

        <div class="cardImg">

          ${
            product.image
            ?
            `<img
              src="${escapeHTML(product.image)}"
              alt="${escapeHTML(product.title)}"
            >`
            :
            `<div style="
              height:100%;
              display:grid;
              place-items:center;
              font-size:50px;
            ">📦</div>`
          }

        </div>

        <div class="cardBody">

          <div class="cardTitle">
            ${escapeHTML(product.title)}
          </div>

          <div class="cardMeta">
            ${escapeHTML(product.category)}
            · vendeur ${escapeHTML(product.seller)}
          </div>

          <div class="cardBottom">

            <strong class="price">
              ${Number(product.price).toFixed(2)} €
            </strong>

            <button
              class="btn light"
              onclick="addCart(${product.id})"
            >
              🛒 Ajouter
            </button>

          </div>

        </div>

      </article>

    `).join("");

}


/* =========================================================
   CATÉGORIE
========================================================= */

function setCategory(value,button){

  category = value;

  document
    .querySelectorAll(".category")
    .forEach(x=>x.classList.remove("active"));

  button.classList.add("active");

  loadProducts();

}


/* =========================================================
   PANIER
========================================================= */

function addCart(id){

  cart.push(id);

  localStorage.setItem(
    "dadashop_cart",
    JSON.stringify(cart)
  );

  updateCartCount();

  showToast("Article ajouté au panier 🛒");

}


function updateCartCount(){

  document.getElementById("cartCount")
    .textContent = cart.length;

}


async function openCart(){

  if(!cart.length){

    openModal(`

      <div class="modalHead">

        <h2>🛒 Panier</h2>

        <button
          class="close"
          onclick="closeModal()"
        >
          ×
        </button>

      </div>

      <div class="empty">
        Ton panier est vide.
      </div>

    `);

    return;

  }

  const data =
    await api("/api/products");

  const items =
    cart
      .map(id=>
        data.products.find(
          p=>p.id===id
        )
      )
      .filter(Boolean);

  const total =
    items.reduce(
      (sum,p)=>sum+Number(p.price),
      0
    );

  openModal(`

    <div class="modalHead">

      <h2>🛒 Ton panier</h2>

      <button
        class="close"
        onclick="closeModal()"
      >
        ×
      </button>

    </div>

    ${items.map((p,index)=>`

      <div style="
        display:flex;
        gap:12px;
        padding:12px 0;
        border-bottom:1px solid var(--border);
      ">

        ${
          p.image
          ?
          `<img
            src="${p.image}"
            style="
              width:75px;
              height:75px;
              object-fit:cover;
              border-radius:12px;
            "
          >`
          :
          "📦"
        }

        <div style="flex:1">

          <strong>
            ${escapeHTML(p.title)}
          </strong>

          <br>

          ${Number(p.price).toFixed(2)} €

        </div>

        <button
          class="btn danger"
          onclick="removeCart(${index})"
        >
          ×
        </button>

      </div>

    `).join("")}

    <div style="
      display:flex;
      justify-content:space-between;
      font-size:21px;
      font-weight:900;
      padding:20px 0;
    ">

      <span>Total</span>

      <span>
        ${total.toFixed(2)} €
      </span>

    </div>

    <button
      class="btn primary"
      style="width:100%"
      onclick="openTestPayment()"
    >
      💳 Continuer vers le paiement
    </button>

  `);

}


function removeCart(index){

  cart.splice(index,1);

  localStorage.setItem(
    "dadashop_cart",
    JSON.stringify(cart)
  );

  updateCartCount();

  openCart();

}


