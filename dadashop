app.post("/api/orders/test-payment", auth, (req, res) => {
  try {
    const productId = Number(req.body.productId);
    const paymentMethod =
      String(req.body.paymentMethod || "test_card");

    const product = db
      .prepare(
        `
        SELECT *
        FROM products
        WHERE id = ?
        `
      )
      .get(productId);

    if (!product) {
      return res.status(404).json({
        error: "Article introuvable."
      });
    }

    if (product.status !== "available") {
      return res.status(400).json({
        error: "Cet article n'est plus disponible."
      });
    }

    if (product.seller_id === req.user.id) {
      return res.status(400).json({
        error: "Tu ne peux pas acheter ton propre article."
      });
    }

    /*
      IMPORTANT :
      Cette route ne débite aucun compte bancaire.
      Elle simule seulement une commande.
    */

    const order = db
      .prepare(
        `
        INSERT INTO orders
        (
          buyer_id,
          product_id,
          seller_id,
          amount,
          status,
          payment_method,
          created_at
        )
        VALUES (?, ?, ?, ?, 'payment_test', ?, ?)
        `
      )
      .run(
        req.user.id,
        product.id,
        product.seller_id,
        product.price,
        paymentMethod,
        new Date().toISOString()
      );

    db.prepare(
      `
      UPDATE products
      SET status = 'sold'
      WHERE id = ?
      `
    ).run(product.id);

    res.json({
      success: true,
      test: true,
      orderId: order.lastInsertRowid,
      message:
        "Commande de test créée. Aucun argent réel n'a été transféré."
    });
  } catch (error) {
    console.error(error);

    res.status(500).json({
      error: "Erreur lors de la commande."
    });
  }
});

