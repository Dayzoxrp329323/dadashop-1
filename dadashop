      n'est débité et aucun vendeur ne reçoit d'argent.
    </div>

  `);

}


async function testPayment(method){

  if(!cart.length){
    return;
  }

  try{

    const productId = cart[0];

    await api(
      "/api/orders/test-payment",
      {
        method:"POST",
        headers:{
          "Content-Type":
            "application/json"
        },
        body:JSON.stringify({
          productId,
          paymentMethod:method
        })
      }
    );

    cart.shift();

    localStorage.setItem(
      "dadashop_cart",
      JSON.stringify(cart)
    );

    updateCartCount();

    closeModal();

    await loadProducts();

    showToast(
      "Commande de test créée ✅"
    );

  }catch(error){

    showToast(error.message);

  }

}


