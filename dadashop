let user =
  JSON.parse(
    localStorage.getItem("dadashop_user") || "null"
  );

let cart =
  JSON.parse(
    localStorage.getItem("dadashop_cart") || "[]"
  );

let category = "all";

const languages = [
  {
    code:"fr",
    title:"Achète. Vends. Recommence.",
    text:"Découvre des articles que tu vas aimer et vends facilement ceux dont tu n'as plus besoin.",
    search:"Rechercher un article..."
